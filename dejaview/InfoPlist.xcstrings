    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy description for local network access",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glassy Desk verbindet sich mit Macs in deinem lokalen oder privaten Netzwerk, um deren Bildschirme anzuzeigen und zu steuern."
