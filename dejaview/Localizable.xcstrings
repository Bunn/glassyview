    "The Mac must be awake and allowed through any firewall before Glassy Desk can connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac muss aktiv sein und jede Firewall passieren dürfen, bevor Glassy Desk eine Verbindung herstellen kann."
          }
        },
        "es" : {
          "stringUnit" : {
