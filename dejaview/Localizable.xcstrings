    "A Glassy Stream connection is already active." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Glassy Stream-Verbindung ist bereits aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una conexión Glassy Stream activa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Stream 接続はすでにアクティブです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een Glassy Stream-verbinding actief."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conexão Glassy Stream já está ativa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Stream 连接已处于活动状态。"
          }
        }
      }
    },
    "A good session starts with the Mac advertising Screen Sharing and being reachable from your current network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gute Sitzung beginnt damit, dass der Mac die Bildschirmfreigabe ankündigt und über Ihr aktuelles Netzwerk erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una buena sesión comienza cuando Mac anuncia Screen Sharing y es accesible desde su red actual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良好なセッションは、Mac が画面共有をアドバタイズし、現在のネットワークからアクセスできる状態になることから始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een goede sessie begint met het adverteren op de Mac, Scherm delen en bereikbaar zijn vanaf uw huidige netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma boa sessão começa com o Mac anunciando o compartilhamento de tela e sendo acessível pela sua rede atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次良好的会话从 Mac 广告屏幕共享开始，并且可以通过当前网络进行访问。"
          }
        }
      }
    },
    "A session supports taps, drags, right click gestures, scrolling, pinch zoom, hardware keyboard input, and the on-screen shortcut strip." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung unterstützt Tippen, Ziehen, Rechtsklick-Gesten, Scrollen, Pinch-Zoom, Hardware-Tastatureingabe und die Verknüpfungsleiste auf dem Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión admite toques, arrastres, gestos de clic derecho, desplazamiento, zoom de pellizco, entrada de teclado de hardware y la franja de accesos directos en pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションは、タップ、ドラッグ、右クリック ジェスチャ、スクロール、ピンチ ズーム、ハードウェア キーボード入力、および画面上のショートカット ストリップをサポートします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een sessie ondersteunt tikken, slepen, rechtsklikgebaren, scrollen, knijpzoom, hardwaretoetsenbordinvoer en de snelkoppelingenstrip op het scherm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão oferece suporte a toques, arrastamentos, gestos de clique com o botão direito, rolagem, pinçamento de zoom, entrada de teclado de hardware e faixa de atalho na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话支持点击、拖动、右键单击手势、滚动、捏合缩放、硬件键盘输入和屏幕快捷方式条。"
          }
        }
      }
    },
