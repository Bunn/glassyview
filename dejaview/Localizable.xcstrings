    "Make sure Glassy Host is running. For remote access, connect Tailscale on both devices and verify TCP port 51515 is allowed by your tailnet policy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sicher, dass Glassy Host ausgeführt wird. Für den Fernzugriff verbinden Sie Tailscale auf beiden Geräten und stellen Sie sicher, dass der TCP-Port 51515 durch Ihre Tailnet-Richtlinie zulässig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que Glassy Host se esté ejecutando. Para acceso remoto, conecte Tailscale en ambos dispositivos y verifique que su política de tailnet permita el puerto 51515 de TCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Host が実行されていることを確認してください。リモート アクセスの場合は、両方のデバイスで Tailscale を接続し、TCP ポート 51515 がテールネット ポリシーで許可されていることを確認します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat Glassy Host actief is. Voor externe toegang verbindt u Tailscale op beide apparaten en controleert u of TCP-poort 51515 is toegestaan ​​door uw staartnetbeleid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que Glassy Host esteja em execução. Para acesso remoto, conecte Tailscale em ambos os dispositivos e verifique se a porta 51515 do TCP é permitida pela sua política de tailnet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保 Glassy Host 正在运行。对于远程访问，请在两台设备上连接 Tailscale 并验证您的 tailnet 策略允许 TCP 端口 51515。"
          }
        }
      }
    },
    "Make sure Glassy Host is running. For remote access, connect Tailscale on both devices and verify the saved address and TCP port 51515." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sicher, dass Glassy Host ausgeführt wird. Für den Fernzugriff schließen Sie Tailscale an beiden Geräten an und überprüfen Sie die gespeicherte Adresse und den TCP-Port 51515."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que Glassy Host se esté ejecutando. Para acceso remoto, conecte Tailscale en ambos dispositivos y verifique la dirección guardada y el puerto TCP 51515."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Host が実行されていることを確認してください。リモート アクセスの場合は、両方のデバイスで Tailscale に接続し、保存されたアドレスと TCP ポート 51515 を確認します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat Glassy Host actief is. Voor externe toegang sluit u Tailscale op beide apparaten aan en verifieert u het opgeslagen adres en TCP-poort 51515."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que Glassy Host esteja em execução. Para acesso remoto, conecte Tailscale em ambos os dispositivos e verifique o endereço salvo e a porta TCP 51515."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保 Glassy Host 正在运行。对于远程访问，请在两台设备上连接 Tailscale 并验证保存的地址和 TCP 端口 51515。"
          }
