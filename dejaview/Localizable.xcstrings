    "Uses the faster encrypted Glassy Host video and input stream. It requires the macOS companion app and asks for a pairing code or configured password the first time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet den schnelleren verschlüsselten Video- und Eingabestream Glassy Host. Es erfordert die Begleit-App macOS und fragt beim ersten Mal nach einem Kopplungscode oder einem konfigurierten Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza el flujo de entrada y video Glassy Host cifrado más rápido. Requiere la aplicación complementaria macOS y solicita un código de emparejamiento o una contraseña configurada la primera vez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より高速な暗号化された Glassy Host ビデオと入力ストリームを使用します。 macOS コンパニオン アプリが必要で、初回はペアリング コードまたは設定されたパスワードを要求されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de snellere gecodeerde Glassy Host video- en invoerstream. Het vereist de begeleidende app macOS en vraagt ​​de eerste keer om een ​​koppelingscode of een geconfigureerd wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa vídeo Glassy Host criptografado mais rápido e fluxo de entrada. Requer o aplicativo complementar macOS e solicita um código de emparelhamento ou senha configurada na primeira vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用更快的加密 Glassy Host 视频和输入流。它需要 macOS 配套应用程序，并在第一次时要求输入配对码或配置的密码。"
          }
        }
      }
    },
