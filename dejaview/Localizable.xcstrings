    "Nearby discovery only finds Macs on the current local network. Tailscale reaches the remote Mac without exposing a public port on your router." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nearby Discovery findet nur Macs im aktuellen lokalen Netzwerk. Tailscale erreicht den Remote-Mac, ohne einen öffentlichen Port auf Ihrem Router freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El descubrimiento cercano solo encuentra Mac en la red local actual. Tailscale llega a la Mac remota sin exponer un puerto público en su enrutador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの検出では、現在のローカル ネットワーク上の Mac のみが検索されます。 Tailscale は、ルーターのパブリック ポートを公開せずにリモート Mac に到達します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met detectie in de buurt worden alleen Macs op het huidige lokale netwerk gevonden. Tailscale bereikt de externe Mac zonder een openbare poort op uw router bloot te leggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A descoberta próxima encontra apenas Macs na rede local atual. Tailscale alcança o Mac remoto sem expor uma porta pública no seu roteador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附近发现仅查找当前本地网络上的 Mac。 Tailscale 无需暴露路由器上的公共端口即可到达远程 Mac。"
          }
        }
      }
    },
