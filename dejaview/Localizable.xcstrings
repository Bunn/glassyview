    "Enter the code displayed by Glassy Host. It changes every minute and remains the recommended default for first-time pairing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den von Glassy Host angezeigten Code ein. Sie ändert sich jede Minute und bleibt die empfohlene Standardeinstellung für die erstmalige Kopplung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrese el código mostrado por Glassy Host. Cambia cada minuto y sigue siendo el valor predeterminado recomendado para el emparejamiento por primera vez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Host で表示されたコードを入力します。これは 1 分ごとに変更され、初回ペアリングの推奨デフォルトのままになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de code in die wordt weergegeven door Glassy Host. Het verandert elke minuut en blijft de aanbevolen standaardwaarde voor de eerste keer koppelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira o código exibido por Glassy Host. Ele muda a cada minuto e continua sendo o padrão recomendado para o primeiro emparelhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Glassy Host 显示的代码。它每分钟都会发生变化，并且仍然是首次配对时建议的默认值。"
          }
        }
      }
    },
    "Enter the current twelve-symbol code, or choose Password if Glassy Host has a reusable pairing password configured." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
