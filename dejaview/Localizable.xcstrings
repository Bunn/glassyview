    "Use Macs that expose macOS Screen Sharing or Remote Management over VNC/RFB." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Macs, die macOS Screen Sharing oder Remote Management über VNC/RFB ermöglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice Mac que expongan macOS Screen Sharing o Remote Management sobre VNC/RFB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VNC/RFB 経由で macOS 画面共有またはリモート管理を公開する Mac を使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Macs waarop macOS scherm delen of extern beheer via VNC/RFB beschikbaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Macs que expõem o compartilhamento de tela macOS ou o gerenciamento remoto sobre VNC/RFB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用通过 macOS 公开 macOS 屏幕共享或远程管理的 Mac。"
          }
        }
      }
    },
    "Use nearby discovery when it is available, or save a host manually for one-tap connections later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie die Erkennung in der Nähe, wenn sie verfügbar ist, oder speichern Sie einen Host manuell für spätere Verbindungen mit nur einem Fingertipp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice la detección cercana cuando esté disponible o guarde un host manualmente para conexiones con un solo toque más adelante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能な場合は近隣探索を使用するか、後でワンタップ接続できるようにホストを手動で保存します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik detectie in de buurt wanneer deze beschikbaar is, of sla een host handmatig op voor verbindingen met één tik later."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a descoberta próxima quando estiver disponível ou salve um host manualmente para conexões com um toque posteriormente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可用时使用附近发现，或手动保存主机以便稍后进行一键连接。"
          }
        }
      }
    },
    "Use no more than %lld characters." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende höchstens %lld Zeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No uses más de %lld caracteres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 文字以内で入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik niet meer dan %lld tekens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use no máximo %lld caracteres."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿超过 %lld 个字符。"
          }
        }
      }
    },
    "Use the Mac's hostname or IP address and normally port 5900 for VNC." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Hostnamen oder die IP-Adresse des Mac und normalerweise Port 5900 für VNC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el nombre de host o la dirección IP de Mac y normalmente el puerto 5900 para VNC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac のホスト名または IP アドレスを使用し、通常は VNC のポート 5900 を使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de hostnaam of het IP-adres van de Mac en normaal gesproken poort 5900 voor VNC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o nome de host ou endereço IP do Mac e normalmente a porta 5900 para VNC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于 VNC，使用 Mac 的主机名或 IP 地址，通常使用端口 5900。"
          }
        }
      }
    },
    "Use the username and password for a Mac account that is allowed to share the screen. If the server uses legacy password-only VNC authentication, leave the username blank and enter the VNC password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Benutzernamen und das Passwort eines Mac-Kontos, das den Bildschirm teilen darf. Wenn der Server die ältere VNC-Authentifizierung nur mit Kennwort verwendet, lassen Sie den Benutzernamen leer und geben Sie das VNC-Kennwort ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el nombre de usuario y la contraseña de una cuenta Mac que pueda compartir la pantalla. Si el servidor utiliza autenticación VNC de contraseña heredada, deje el nombre de usuario en blanco e ingrese la contraseña VNC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の共有が許可されている Mac アカウントのユーザー名とパスワードを使用します。サーバーが従来のパスワードのみの VNC 認証を使用する場合は、ユーザー名を空白のままにして、VNC パスワードを入力します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de gebruikersnaam en het wachtwoord van een Mac-account waarmee u het scherm mag delen. Als de server gebruikmaakt van de verouderde VNC-authenticatie met alleen een wachtwoord, laat u de gebruikersnaam leeg en voert u het VNC-wachtwoord in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o nome de usuário e a senha de uma conta Mac com permissão para compartilhar a tela. Se o servidor usar autenticação VNC herdada somente com senha, deixe o nome de usuário em branco e insira a senha VNC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用允许共享屏幕的 Mac 帐户的用户名和密码。如果服务器使用传统的仅密码 VNC 身份验证，请将用户名留空并输入 VNC 密码。"
          }
        }
      }
    },
    "Use touch or a keyboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
