    "Tap a nearby Mac, or choose New Machine and enter a hostname, IP address, and port. Screen Sharing usually uses port 5900." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf einen Mac in der Nähe oder wählen Sie „Neue Maschine“ und geben Sie einen Hostnamen, eine IP-Adresse und einen Port ein. Die Bildschirmfreigabe verwendet normalerweise Port 5900."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque una Mac cercana o elija Nueva máquina e ingrese un nombre de host, dirección IP y puerto. Compartir pantalla suele utilizar el puerto 5900."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの Mac をタップするか、[新しいマシン] を選択してホスト名、IP アドレス、ポートを入力します。画面共有には通常、ポート 5900 が使用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een Mac in de buurt of kies Nieuwe machine en voer een hostnaam, IP-adres en poort in. Scherm delen gebruikt meestal poort 5900."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um Mac próximo ou escolha Nova máquina e insira um nome de host, endereço IP e porta. O compartilhamento de tela geralmente usa a porta 5900."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击附近的 Mac，或选择“新计算机”并输入主机名、IP 地址和端口。屏幕共享通常使用端口 5900。"
          }
        }
      }
    },
    "Tap, drag, scroll, zoom, type, and send common shortcuts during a remote session." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
