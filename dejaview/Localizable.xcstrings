    },
    "Use a Mac account that is allowed to share the screen. Legacy VNC servers may only need a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie ein Mac-Konto, das den Bildschirm teilen darf. Ältere VNC-Server benötigen möglicherweise nur ein Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice una cuenta de Mac que tenga permiso para compartir la pantalla. Es posible que los servidores VNC heredados solo necesiten una contraseña."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面共有が許可されている Mac アカウントを使用してください。従来の VNC サーバーにはパスワードのみが必要な場合があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een Mac-account waarmee u het scherm kunt delen. Oudere VNC-servers hebben mogelijk alleen een wachtwoord nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma conta Mac com permissão para compartilhar a tela. Servidores VNC legados podem precisar apenas de uma senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用允许共享屏幕的 Mac 帐户。旧版 VNC 服务器可能只需要密码。"
          }
        }
      }
    },
