    "When this Mac is unreachable, Glassy Desk can wake it and connect automatically. Enable “Wake for network access” in macOS System Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieser Mac nicht erreichbar ist, kann Glassy Desk ihn aktivieren und automatisch eine Verbindung herstellen. Aktivieren Sie „Wake für Netzwerkzugriff“ in den macOS-Systemeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando no se puede acceder a esta Mac, Glassy Desk puede reactivarla y conectarse automáticamente. Habilite \"Activar para acceder a la red\" en la configuración del sistema macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac にアクセスできない場合、Glassy Desk は Mac を起動して自動的に接続できます。 macOS システム設定で「ネットワーク アクセスのためのウェイク」を有効にします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer deze Mac onbereikbaar is, kan Glassy Desk hem uit de slaapstand halen en automatisch verbinding maken. Schakel \"Wake for network access\" in in de macOS-systeeminstellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando este Mac está inacessível, Glassy Desk pode ativá-lo e conectar-se automaticamente. Ative “Ativar para acesso à rede” nas configurações do sistema macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此 Mac 无法访问时，Glassy Desk 可以唤醒它并自动连接。在 macOS 系统设置中启用“唤醒网络访问”。"
          }
        }
      }
    },
