    "Glassy Desk connects your iPhone or iPad to a Mac so you can view and control its desktop over VNC or Glassy Stream." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindet Ihren iPhone oder iPad mit einem Mac, sodass Sie dessen Desktop über VNC oder Glassy Stream anzeigen und steuern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta su iPhone o iPad a una Mac para que pueda ver y controlar su escritorio a través de VNC o Glassy Stream."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は、iPhone または iPad を Mac に接続し、VNC または Glassy Stream 経由でそのデスクトップを表示および制御できるようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindt uw iPhone of iPad met een Mac, zodat u het bureaublad kunt bekijken en bedienen via VNC of Glassy Stream."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta seu iPhone ou iPad a um Mac para que você possa visualizar e controlar sua área de trabalho por meio de VNC ou Glassy Stream."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 将您的 iPhone 或 iPad 连接到 Mac，以便您可以通过 VNC 或 Glassy Stream 查看和控制其桌面。"
          }
        }
      }
    },
    "Glassy Desk connects your iPhone or iPad to a Mac's built-in Screen Sharing service so you can view and control the desktop over VNC/RFB." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindet Ihr iPhone oder iPad mit dem integrierten Bildschirmfreigabedienst eines Mac, sodass Sie den Desktop über VNC/RFB anzeigen und steuern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta su iPhone o iPad al servicio de pantalla compartida integrado de una Mac para que pueda ver y controlar el escritorio a través de VNC/RFB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は、iPhone または iPad を Mac の内蔵画面共有サービスに接続し、VNC/RFB 経由でデスクトップを表示および制御できるようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindt uw iPhone of iPad met de ingebouwde schermdelingsservice van een Mac, zodat u het bureaublad via VNC/RFB kunt bekijken en bedienen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta seu iPhone ou iPad ao serviço de compartilhamento de tela integrado do Mac para que você possa visualizar e controlar a área de trabalho pelo VNC/RFB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 将您的 iPhone 或 iPad 连接到 Mac 的内置屏幕共享服务，以便您可以通过 VNC/RFB 查看和控制桌面。"
          }
        }
      }
    },
    "Glassy Desk connects your iPhone or iPad to macOS Screen Sharing so you can view and control your desktop from the devices you already carry." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindet Ihren iPhone oder iPad mit der Bildschirmfreigabe macOS, sodass Sie Ihren Desktop von den Geräten, die Sie bereits bei sich tragen, anzeigen und steuern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta su iPhone o iPad a macOS Screen Sharing para que pueda ver y controlar su escritorio desde los dispositivos que ya tiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は、iPhone または iPad を macOS 画面共有に接続し、既に持ち運んでいるデバイスからデスクトップを表示および制御できるようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk verbindt uw iPhone of iPad met macOS Scherm delen, zodat u uw bureaublad kunt bekijken en bedienen vanaf de apparaten die u al bij u heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk conecta seu iPhone ou iPad ao compartilhamento de tela macOS para que você possa visualizar e controlar sua área de trabalho a partir dos dispositivos que você já carrega."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 将您的 iPhone 或 iPad 连接到 macOS 屏幕共享，以便您可以从已携带的设备查看和控制您的桌面。"
          }
        }
      }
    },
    "Glassy Desk couldn't reconnect after %lld attempts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk konnte nach %lld Versuchen keine neue Verbindung herstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk no pudo volver a conectarse después de %lld intentos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は %lld 回試行しても再接続できませんでした。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk kon na %lld pogingen niet opnieuw verbinden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glassy Desk não conseguiu se reconectar após %lld tentativas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 尝试 %lld 次后仍无法重新连接。"
          }
        }
      }
    },
    "Glassy Desk is built for Macs exposing macOS Screen Sharing or Remote Management through the classic VNC/RFB path. Multiple displays may appear as separate choices or as one combined desktop depending on what the Mac exposes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk wurde für Macs entwickelt, die die Bildschirmfreigabe oder Fernverwaltung von macOS über den klassischen VNC/RFB-Pfad ermöglichen. Je nachdem, was der Mac anzeigt, können mehrere Anzeigen als separate Auswahlmöglichkeiten oder als ein kombinierter Desktop angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk está diseñado para Mac que exponen el uso compartido de pantalla o la administración remota de macOS a través de la ruta clásica VNC/RFB. Es posible que aparezcan varias pantallas como opciones separadas o como un escritorio combinado dependiendo de lo que exponga la Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は、クラシック VNC/RFB パスを介して macOS 画面共有またはリモート管理を公開する Mac 用に構築されています。 Mac が何を公開しているかに応じて、複数のディスプレイが個別の選択肢として表示されることも、1 つの結合されたデスクトップとして表示されることもあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk is gebouwd voor Macs die macOS scherm delen of extern beheer toegankelijk maken via het klassieke VNC/RFB-pad. Meerdere beeldschermen kunnen verschijnen als afzonderlijke keuzes of als één gecombineerd bureaublad, afhankelijk van wat de Mac laat zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk foi desenvolvido para Macs expondo o compartilhamento de tela macOS ou gerenciamento remoto por meio do caminho clássico VNC/RFB. Vários monitores podem aparecer como opções separadas ou como uma área de trabalho combinada, dependendo do que o Mac expõe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 专为 Mac 构建，通过经典的 VNC/RFB 路径公开 macOS 屏幕共享或远程管理。多个显示器可能会显示为单独的选项或显示为一个组合桌面，具体取决于 Mac 所显示的内容。"
          }
        }
      }
    },
    "Glassy Desk is tuned for Apple's classic Screen Sharing path over VNC/RFB." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk ist auf Apples klassischen Screen-Sharing-Pfad über VNC/RFB abgestimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk está optimizado para la ruta clásica de uso compartido de pantalla de Apple sobre VNC/RFB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk は、VNC/RFB を介した Apple の従来の画面共有パス用に調整されています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk is afgestemd op het klassieke scherm delen-pad van Apple via VNC/RFB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk está ajustado para o caminho clássico de compartilhamento de tela da Apple em VNC/RFB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk 针对 VNC/RFB 上的 Apple 经典屏幕共享路径进行了调整。"
          }
        }
      }
    },
