        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glassy Desk が接続するには、Mac が起動しており、ファイアウォールの通過が許可されている必要があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
